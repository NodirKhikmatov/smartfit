PORT=3000
# Empty = SQLite file below. Set to postgres://user:pass@host:5432/smartfit for PostgreSQL.
DATABASE_URL=
SQLITE_FILE=./smartfit.db
# Signs admin login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
# Product images from the admin panel (served at /uploads). Customer photos are never saved.
UPLOAD_DIR=./uploads
# Public address used in the store QR codes (e.g. https://fit.example.uz). Empty = the address the admin opened.
PUBLIC_URL=
# Claude stylist (task 7). Empty key = rule-based recommendations only. The model must accept a forced tool_choice.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Online payment (task 9). A provider is off, and hidden in the app, until all its keys are set; cashier payment always works.
# Callback URLs to register with the provider: https://<PUBLIC_URL>/api/pay/payme, .../api/pay/click/prepare, .../api/pay/click/complete
# Payme: merchant id and key from the cabinet (use the TEST_KEY while testing). Live checkout: https://checkout.paycom.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://test.paycom.uz
# Click SHOP API: service id, merchant id and secret key from the Click merchant cabinet.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Order messages to customers (task 10). Create a bot with @BotFather; both values are needed, empty = no messages.
# The app long-polls Telegram (getUpdates), so run one app instance and don't set a webhook on this bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# --- Deploy (task 11) ---
# docker compose: the PostgreSQL password (compose builds DATABASE_URL from it) and the HTTPS domain for Caddy.
# DOMAIN=localhost gives a local self-signed certificate; a real domain gets Let's Encrypt automatically.
# Use letters and digits only in POSTGRES_PASSWORD (it goes into a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
DOMAIN=localhost
# production: requires ADMIN_TOKEN_SECRET, blocks `npm run seed`. compose sets it for the app container.
NODE_ENV=
# Number of reverse proxies in front of the app (compose sets 1 for Caddy). Empty = none, X-Forwarded-* ignored.
TRUST_PROXY=
# Optional error alerts: every error log line is POSTed as JSON {text, content} (Slack/Discord/Mattermost webhook), max 10/min.
ERROR_WEBHOOK_URL=
# --- Hardening (task 21) ---
# Per-IP requests per minute (0 = off). Phones on the shop Wi-Fi share the kiosk's IP, so keep these generous.
RATE_RECOMMEND_PER_MIN=60
RATE_SIZE_PER_MIN=30
RATE_CART_PER_MIN=300
RATE_LOGIN_PER_MIN=20
RATE_KIOSK_PER_MIN=30
RATE_PIN_PER_MIN=5
# Live carts (stock holds) per client IP at once.
MAX_OPEN_CARTS_PER_IP=30

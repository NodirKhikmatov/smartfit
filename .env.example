PORT=3000
# Empty = SQLite file below. Set to postgres://user:pass@host:5432/smartfit for PostgreSQL.
DATABASE_URL=
SQLITE_FILE=./smartfit.db
# Signs admin login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
# Product images from the admin panel (served at /uploads). Customer photos are never saved.
UPLOAD_DIR=./uploads

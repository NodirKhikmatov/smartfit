PORT=3000
# Empty = SQLite file below. Set to postgres://user:pass@host:5432/smartfit for PostgreSQL.
DATABASE_URL=
SQLITE_FILE=./smartfit.db
# Signs admin login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
# Product images from the admin panel (served at /uploads). Customer photos are never saved.
UPLOAD_DIR=./uploads
# Public address used in the store QR codes (e.g. https://fit.example.uz). Empty = the address the admin opened.
PUBLIC_URL=
# Claude stylist (task 7). Empty key = rule-based recommendations only. The model must accept a forced tool_choice.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Online payment (task 9). A provider is off, and hidden in the app, until all its keys are set; cashier payment always works.
# Callback URLs to register with the provider: https://<PUBLIC_URL>/api/pay/payme, .../api/pay/click/prepare, .../api/pay/click/complete
# Payme: merchant id and key from the cabinet (use the TEST_KEY while testing). Live checkout: https://checkout.paycom.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://test.paycom.uz
# Click SHOP API: service id, merchant id and secret key from the Click merchant cabinet.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
